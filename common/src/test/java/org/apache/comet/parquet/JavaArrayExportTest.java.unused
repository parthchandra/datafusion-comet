package org.apache.comet.parquet;

import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Test suite for Java array export functionality to native Rust via JNI. These tests verify that
 * arrays can be properly exported to Rust memory, managed correctly, and freed without memory
 * leaks.
 */
public class JavaArrayExportTest {

  @Test
  public void testIntArrayExport() {
    // Test data
    int[] javaArray = {1, 2, 3, 4, 5, -10, 0, Integer.MAX_VALUE, Integer.MIN_VALUE};

    // Export to native
    long ptr = Native.exportIntArray(javaArray);

    // Verify pointer is not null/zero
    assertNotEquals(0, ptr, "Exported array pointer should not be zero");

    // Free the exported array
    Native.freeExportedIntArray(ptr);

    System.out.println("✓ Int array export test passed");
  }

  @Test
  public void testLongArrayExport() {
    // Test data
    long[] javaArray = {
      1L, 2L, 3L, 1000000000000L, -999999999999L, 0L, Long.MAX_VALUE, Long.MIN_VALUE
    };

    // Export to native
    long ptr = Native.exportLongArray(javaArray);

    // Verify pointer is not null/zero
    assertNotEquals(0, ptr, "Exported array pointer should not be zero");

    // Free the exported array
    Native.freeExportedLongArray(ptr);

    System.out.println("✓ Long array export test passed");
  }

  @Test
  public void testDoubleArrayExport() {
    // Test data
    double[] javaArray = {
      1.0,
      2.5,
      3.14159,
      -1.0,
      0.0,
      Double.MAX_VALUE,
      Double.MIN_VALUE,
      Double.NaN,
      Double.POSITIVE_INFINITY
    };

    // Export to native
    long ptr = Native.exportDoubleArray(javaArray);

    // Verify pointer is not null/zero
    assertNotEquals(0, ptr, "Exported array pointer should not be zero");

    // Free the exported array
    Native.freeExportedDoubleArray(ptr);

    System.out.println("✓ Double array export test passed");
  }

  @Test
  public void testStringArrayExport() {
    // Test data
    String[] javaArray = {"Hello", "World", "Java", "Rust", "JNI", "", "Unicode: 🦀", null};

    // Export to native
    long ptr = Native.exportStringArray(javaArray);

    // Verify pointer is not null/zero
    assertNotEquals(0, ptr, "Exported array pointer should not be zero");

    // Free the exported array
    Native.freeExportedStringArray(ptr);

    System.out.println("✓ String array export test passed");
  }

  @Test
  public void testEmptyArrays() {
    // Test empty int array
    int[] emptyIntArray = {};
    long intPtr = Native.exportIntArray(emptyIntArray);
    assertNotEquals(0, intPtr, "Empty int array should still return valid pointer");
    Native.freeExportedIntArray(intPtr);

    // Test empty long array
    long[] emptyLongArray = {};
    long longPtr = Native.exportLongArray(emptyLongArray);
    assertNotEquals(0, longPtr, "Empty long array should still return valid pointer");
    Native.freeExportedLongArray(longPtr);

    // Test empty double array
    double[] emptyDoubleArray = {};
    long doublePtr = Native.exportDoubleArray(emptyDoubleArray);
    assertNotEquals(0, doublePtr, "Empty double array should still return valid pointer");
    Native.freeExportedDoubleArray(doublePtr);

    // Test empty string array
    String[] emptyStringArray = {};
    long stringPtr = Native.exportStringArray(emptyStringArray);
    assertNotEquals(0, stringPtr, "Empty string array should still return valid pointer");
    Native.freeExportedStringArray(stringPtr);

    System.out.println("✓ Empty array export test passed");
  }

  @Test
  public void testLargeArrays() {
    // Test large arrays to stress memory management
    int size = 100000;

    // Large int array
    int[] largeIntArray = new int[size];
    for (int i = 0; i < size; i++) {
      largeIntArray[i] = i * 2;
    }
    long intPtr = Native.exportIntArray(largeIntArray);
    assertNotEquals(0, intPtr);
    Native.freeExportedIntArray(intPtr);

    // Large double array
    double[] largeDoubleArray = new double[size];
    for (int i = 0; i < size; i++) {
      largeDoubleArray[i] = i * 0.5;
    }
    long doublePtr = Native.exportDoubleArray(largeDoubleArray);
    assertNotEquals(0, doublePtr);
    Native.freeExportedDoubleArray(doublePtr);

    System.out.println("✓ Large array export test passed");
  }

  @Test
  public void testMultipleExportsAndFrees() {
    // Test exporting and freeing multiple arrays to check for memory leaks
    for (int i = 0; i < 1000; i++) {
      int[] array = {i, i + 1, i + 2};
      long ptr = Native.exportIntArray(array);
      assertNotEquals(0, ptr);
      Native.freeExportedIntArray(ptr);
    }

    System.out.println("✓ Multiple export/free cycles test passed");
  }

  @Test
  public void testFreeZeroPointer() {
    // Test that freeing a zero pointer doesn't crash (should be safe no-op)
    assertDoesNotThrow(() -> Native.freeExportedIntArray(0L));
    assertDoesNotThrow(() -> Native.freeExportedLongArray(0L));
    assertDoesNotThrow(() -> Native.freeExportedDoubleArray(0L));
    assertDoesNotThrow(() -> Native.freeExportedStringArray(0L));

    System.out.println("✓ Free zero pointer test passed");
  }

  @Test
  public void testArrayExportIntegration() {
    // Integration test combining multiple array types
    int[] intArray = {10, 20, 30};
    long[] longArray = {100L, 200L, 300L};
    double[] doubleArray = {1.1, 2.2, 3.3};
    String[] stringArray = {"test1", "test2", "test3"};

    // Export all arrays
    long intPtr = Native.exportIntArray(intArray);
    long longPtr = Native.exportLongArray(longArray);
    long doublePtr = Native.exportDoubleArray(doubleArray);
    long stringPtr = Native.exportStringArray(stringArray);

    // Verify all pointers are valid
    assertNotEquals(0, intPtr);
    assertNotEquals(0, longPtr);
    assertNotEquals(0, doublePtr);
    assertNotEquals(0, stringPtr);

    // Verify all pointers are different
    assertNotEquals(intPtr, longPtr);
    assertNotEquals(intPtr, doublePtr);
    assertNotEquals(intPtr, stringPtr);
    assertNotEquals(longPtr, doublePtr);
    assertNotEquals(longPtr, stringPtr);
    assertNotEquals(doublePtr, stringPtr);

    // Free all arrays
    Native.freeExportedIntArray(intPtr);
    Native.freeExportedLongArray(longPtr);
    Native.freeExportedDoubleArray(doublePtr);
    Native.freeExportedStringArray(stringPtr);

    System.out.println("✓ Array export integration test passed");
  }
}
