package org.apache.comet.vector

import org.junit.jupiter.api.{AfterEach, BeforeEach, Test}
import org.junit.jupiter.api.Assertions._

import org.apache.arrow.memory.RootAllocator
import org.apache.arrow.vector.VarCharVector
import org.apache.spark.sql.vectorized.ColumnarBatch

/**
 * Tests for NativeUtil handling of CometSelectionVector instances.
 */
class NativeUtilSelectionVectorTest {

  private var allocator: RootAllocator = _
  private var nativeUtil: NativeUtil = _

  @BeforeEach
  def setUp(): Unit = {
    allocator = new RootAllocator()
    nativeUtil = new NativeUtil()
  }

  @AfterEach
  def tearDown(): Unit = {
    if (nativeUtil != null) {
      nativeUtil.close()
    }
    if (allocator != null) {
      allocator.close()
    }
  }

  @Test
  def testExportBatchWithSelectionVector(): Unit = {
    // Create original data
    val originalVector = new VarCharVector("test_data", allocator)
    originalVector.allocateNew(1024, 6)
    originalVector.setSafe(0, "apple".getBytes)
    originalVector.setSafe(1, "banana".getBytes)
    originalVector.setSafe(2, "cherry".getBytes)
    originalVector.setSafe(3, "date".getBytes)
    originalVector.setSafe(4, "elderberry".getBytes)
    originalVector.setSafe(5, "fig".getBytes)
    originalVector.setValueCount(6)

    // Create CometVector wrapper
    val cometVector = new CometPlainVector(originalVector, false)

    // Create selection indices [0, 2, 4, 5] - selecting "apple", "cherry", "elderberry", "fig"
    val selectionIndices = Array(0, 2, 4, 5)
    val selectionVector = new CometSelectionVector(cometVector, selectionIndices)

    // Create a batch with the selection vector
    val batch = new ColumnarBatch(Array(selectionVector), 4)

    // Test basic batch properties
    assertEquals(1, batch.numCols())
    assertEquals(4, batch.numRows())

    // Test that the selection vector is correctly identified
    batch.column(0) match {
      case sv: CometSelectionVector =>
        assertEquals(4, sv.numValues())
        assertEquals("apple", sv.getUTF8String(0).toString)
        assertEquals("cherry", sv.getUTF8String(1).toString)
        assertEquals("elderberry", sv.getUTF8String(2).toString)
        assertEquals("fig", sv.getUTF8String(3).toString)
      case _ =>
        fail("Expected CometSelectionVector")
    }

    // Test export functionality
    val (arrays, schemas) = nativeUtil.allocateArrowStructs(1)
    val arrayAddrs = arrays.map(_.memoryAddress())
    val schemaAddrs = schemas.map(_.memoryAddress())

    // This should not throw an exception and should handle the selection vector properly
    val numRows = nativeUtil.exportBatch(arrayAddrs, schemaAddrs, batch)

    // Verify that the correct number of rows is returned (from selection vector, not original)
    assertEquals(4, numRows)

    // Clean up
    arrays.foreach(_.close())
    schemas.foreach(_.close())
    selectionVector.close()
    originalVector.close()
  }

  @Test
  def testTakeRowsWithSelectionVector(): Unit = {
    // Create original data
    val originalVector = new VarCharVector("test_data", allocator)
    originalVector.allocateNew(1024, 8)
    for (i <- 0 until 8) {
      originalVector.setSafe(i, s"value$i".getBytes)
    }
    originalVector.setValueCount(8)

    // Create CometVector wrapper
    val cometVector = new CometPlainVector(originalVector, false)

    // Create selection indices [1, 3, 5, 7]
    val selectionIndices = Array(1, 3, 5, 7)
    val selectionVector = new CometSelectionVector(cometVector, selectionIndices)

    // Create a batch with the selection vector
    val batch = new ColumnarBatch(Array(selectionVector), 4)

    // Test takeRows functionality - take 2 rows starting from index 1
    val slicedBatch = nativeUtil.takeRows(batch, 1, 2)

    assertEquals(1, slicedBatch.numCols())
    assertEquals(2, slicedBatch.numRows())

    // Verify the sliced selection vector contains the correct data
    slicedBatch.column(0) match {
      case sv: CometSelectionVector =>
        assertEquals(2, sv.numValues())
        // Should contain values at original indices 3 and 5 (which are "value3" and "value5")
        assertEquals("value3", sv.getUTF8String(0).toString)
        assertEquals("value5", sv.getUTF8String(1).toString)
      case _ =>
        fail("Expected CometSelectionVector")
    }

    // Clean up
    slicedBatch.close()
    selectionVector.close()
    originalVector.close()
  }

  @Test
  def testMixedBatchWithSelectionAndRegularVectors(): Unit = {
    // Create two original vectors
    val vector1 = new VarCharVector("data1", allocator)
    vector1.allocateNew(1024, 4)
    vector1.setSafe(0, "a".getBytes)
    vector1.setSafe(1, "b".getBytes)
    vector1.setSafe(2, "c".getBytes)
    vector1.setSafe(3, "d".getBytes)
    vector1.setValueCount(4)

    val vector2 = new VarCharVector("data2", allocator)
    vector2.allocateNew(1024, 3)
    vector2.setSafe(0, "x".getBytes)
    vector2.setSafe(1, "y".getBytes)
    vector2.setSafe(2, "z".getBytes)
    vector2.setValueCount(3)

    val cometVector1 = new CometPlainVector(vector1, false)
    val cometVector2 = new CometPlainVector(vector2, false)

    // Create selection vector from first vector
    val selectionIndices = Array(0, 2, 3) // Select "a", "c", "d"
    val selectionVector = new CometSelectionVector(cometVector1, selectionIndices)

    // Create batch with mixed vector types
    val batch = new ColumnarBatch(Array(selectionVector, cometVector2), 3)

    assertEquals(2, batch.numCols())
    assertEquals(3, batch.numRows())

    // Test export with mixed vector types
    val (arrays, schemas) = nativeUtil.allocateArrowStructs(2)
    val arrayAddrs = arrays.map(_.memoryAddress())
    val schemaAddrs = schemas.map(_.memoryAddress())

    val numRows = nativeUtil.exportBatch(arrayAddrs, schemaAddrs, batch)
    assertEquals(3, numRows)

    // Clean up
    arrays.foreach(_.close())
    schemas.foreach(_.close())
    selectionVector.close()
    vector1.close()
    vector2.close()
  }
}
